# Copiá este archivo a application-local.properties (ese sí está en .gitignore) y completá tus valores.

spring.datasource.url=jdbc:sqlserver://localhost:1433;databaseName=mycar_db;encrypt=false;trustServerCertificate=true
spring.datasource.username=sa
spring.datasource.password=TU_PASSWORD

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# SendGrid (envío de mails: reset de password, 2FA, alertas)
app.sendgrid.api-key=TU_SENDGRID_API_KEY
app.sendgrid.from-email=tu-remitente@ejemplo.com

# ExchangeRate API (cotización dashboard)
app.exchange-rate.api-key=TU_EXCHANGE_RATE_API_KEY

# Chat IA con RAG (Spring AI + OpenAI) — platform.openai.com > API keys
spring.ai.openai.api-key=TU_OPENAI_API_KEY
